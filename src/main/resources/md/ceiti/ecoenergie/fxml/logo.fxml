-->

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="logo-text" alignment="CENTER_LEFT">
    <Label text="ECO" styleClass="logo-litere"/>
    <FontIcon iconLiteral="mdi2f-flash" styleClass="logo-fulger"/>
    <Label text="ENERGIE" styleClass="logo-litere"/>
</HBox>
